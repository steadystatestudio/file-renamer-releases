function IsUpper(C: WideChar): Boolean; begin Result:=TCharacter.IsUpper(C); end;
function IsLower(C: WideChar): Boolean; begin Result:=TCharacter.IsLower(C); end;
function IsDigit(C: WideChar): Boolean; begin Result:=(C>='0') and (C<='9'); end;
function IsSpace(C: WideChar): Boolean; begin Result:=TCharacter.IsWhiteSpace(C); end;
function IsPunct(C: WideChar): Boolean; begin Result:=TCharacter.IsPunctuation(C); end;
function IsControl(C: WideChar): Boolean; begin Result:=TCharacter.IsControl(C); end;
function IsBlank(C: WideChar): Boolean; begin Result:=(C=' ') or (C=#9); end;
function IsHex(C: WideChar): Boolean; begin Result:=IsDigit(C) or ((UpCase(C)>='A') and (UpCase(C)<='F')); end;
function IsAlpha(C: WideChar): Boolean; begin Result:=TCharacter.IsLetter(C); end;
function IsAlphaNumeric(C: WideChar): Boolean; begin Result:=TCharacter.IsLetterOrDigit(C); end;
function CharUpper(C: WideChar): WideChar; begin Result:=TCharacter.ToUpper(C); end;
function CharLower(C: WideChar): WideChar; begin Result:=TCharacter.ToLower(C); end;
function WideCharacter(Code: Word): WideChar; begin Result:=WideChar(Code); end;
function BoundaryLeft(const S: WideString; Position: Integer): Boolean;
begin Result:=(Position>=1) and (Position<=Length(S)) and IsAlphaNumeric(S[Position]) and
 ((Position=1) or not IsAlphaNumeric(S[Position-1])); end;
function BoundaryRight(const S: WideString; Position: Integer): Boolean;
begin Result:=(Position>=1) and (Position<=Length(S)) and IsAlphaNumeric(S[Position]) and
 ((Position=Length(S)) or not IsAlphaNumeric(S[Position+1])); end;
function ScanDT(const Pattern,Subject: AnsiString): TDateTime;
begin Result:=ScanDateTime(Pattern,Subject); end;
function TryScanDT(const Pattern,Subject: AnsiString; var Value: TDateTime): Boolean;
begin try Value:=ScanDT(Pattern,Subject); Result:=True; except Result:=False; end; end;
function ToUnix(D: TDateTime): Int64; begin Result:=DateTimeToUnix(D,True); end;
function FromUnix(U: Int64): TDateTime; begin Result:=UnixToDateTime(U,True); end;
function RegexMatches(const S,P: WideString; Sensitive: Boolean): Boolean;
var R:TRegExpr;
begin R:=TRegExpr.Create; try R.ModifierI:=not Sensitive; R.Expression:=P; Result:=R.Exec(S); finally R.Free; end; end;
function RegexReplace(const S,P,Replacement: WideString; Sensitive,Substitute: Boolean): WideString;
var R:TRegExpr;
begin R:=TRegExpr.Create; try R.ModifierI:=not Sensitive; R.Expression:=P; Result:=R.Replace(S,Replacement,Substitute); finally R.Free; end; end;
function RegexList(const S,P: WideString; Sensitive,Subgroups: Boolean): WideString;
var R:TRegExpr; I:Integer;
begin
 R:=TRegExpr.Create; Result:='';
 try R.ModifierI:=not Sensitive; R.Expression:=P;
 if R.Exec(S) then begin
   if Subgroups then for I:=1 to R.SubExprMatchCount do Result:=Result+R.Match[I]+#0
   else repeat Result:=Result+R.Match[0]+#0; until not R.ExecNext;
 end;
 finally R.Free; end;
end;
function RegexFullList(const S,P: WideString; Sensitive: Boolean): WideString;
begin Result:=RegexList(S,P,Sensitive,False); end;
function RegexSubList(const S,P: WideString; Sensitive: Boolean): WideString;
begin Result:=RegexList(S,P,Sensitive,True); end;
function RegexPositions(const S,P: WideString; Sensitive: Boolean): WideString;
var R:TRegExpr;
begin R:=TRegExpr.Create; Result:=''; try R.ModifierI:=not Sensitive; R.Expression:=P;
 if R.Exec(S) then repeat Result:=Result+UTF8Decode(IntToStr(R.MatchPos[0]))+#0; until not R.ExecNext;
 finally R.Free; end; end;
