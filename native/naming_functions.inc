procedure ScriptError(const S:AnsiString); begin raise Exception.Create(S); end;
function MinInteger(A,B:Integer):Integer; begin Result:=Min(A,B); end;
function MaxInteger(A,B:Integer):Integer; begin Result:=Max(A,B); end;
function MinInteger64(A,B:Int64):Int64; begin Result:=Min(A,B); end;
function MaxInteger64(A,B:Int64):Int64; begin Result:=Max(A,B); end;
function MinFloating(A,B:Extended):Extended; begin Result:=Min(A,B); end;
function MaxFloating(A,B:Extended):Extended; begin Result:=Max(A,B); end;
procedure DivideModulo(A:Integer; B:Word; var Q,R:Word); begin Q:=A div B; R:=A mod B; end;
function RandomFloating:Extended; begin Result:=Random; end;
function RandomBool:Boolean; begin Result:=Random(2)=1; end;
function RandomText(Len:Integer; const Chars:AnsiString):AnsiString;
var I:Integer;
begin
 if (Len<0) or (Len>32768) or (Chars='') then raise Exception.Create('Invalid random string');
 Result:=''; for I:=1 to Len do Result:=Result+Chars[Random(Length(Chars))+1];
end;
function BaseEncode(const S:AnsiString):AnsiString; begin Result:=EncodeStringBase64(S); end;
function BaseDecode(const S:AnsiString):AnsiString; begin Result:=DecodeStringBase64(S); end;
function UrlEncodeText(const S:WideString; Plus:Boolean):AnsiString;
begin Result:=UTF8Encode(Bridge('urlencode',S,UTF8Decode(BoolToStr(Plus,True)))); end;
function UrlDecodeText(const S:AnsiString; Plus:Boolean):WideString;
begin Result:=Bridge('urldecode',UTF8Decode(S),UTF8Decode(BoolToStr(Plus,True))); end;
function RomanInt(const S:AnsiString):Integer; begin Result:=StrToInt(UTF8Encode(Bridge('romanint',UTF8Decode(S),''))); end;
function RomanIntDef(const S:AnsiString; Default:Integer):Integer;
begin try Result:=RomanInt(S); except Result:=Default; end; end;
function TryRomanInt(const S:AnsiString; var Value:Integer):Boolean;
begin try Value:=RomanInt(S); Result:=True; except Result:=False; end; end;
procedure GlobalSet(const Name:AnsiString; Value:Variant);
var J:TJSONObject;
begin
 J:=TJSONObject.Create; try
   case VarType(Value) of
     varEmpty,varNull:J.Add('value',TJSONNull.Create);
     varBoolean:J.Add('value',Boolean(Value));
     varByte,varSmallint,varInteger,varShortInt,varWord,varLongWord,varInt64:J.Add('value',Int64(Value));
     varSingle,varDouble,varCurrency,varDate:J.Add('value',Double(Value));
     varString,varOleStr,varUString:J.Add('value',UTF8Encode(WideString(Value)));
   else raise Exception.Create('Global variables support scalar values'); end;
   Bridge('setglobal',UTF8Decode(Name),UTF8Decode(J.AsJSON));
 finally J.Free; end;
end;
function GlobalGet(const Name:AnsiString):Variant;
var J:TJSONData; V:TJSONData;
begin
 J:=GetJSON(UTF8Encode(Bridge('getglobal',UTF8Decode(Name),'')));
 try V:=TJSONObject(J).Find('value');
 if V=nil then Result:=Unassigned else case V.JSONType of
   jtNull:Result:=Null;
   jtBoolean:Result:=V.AsBoolean;
   jtNumber:if (Pos('.',V.AsJSON)>0) or (Pos('e',LowerCase(V.AsJSON))>0) then Result:=V.AsFloat else Result:=V.AsInt64;
   jtString:Result:=UTF8Decode(V.AsString);
 else Result:=Unassigned; end;
 finally J.Free; end;
end;
function GlobalHas(const Name:AnsiString):Boolean;
begin Result:=Bridge('hasglobal',UTF8Decode(Name),'')='True'; end;
function GlobalGetDef(const Name:AnsiString; Default:Variant):Variant;
begin if GlobalHas(Name) then Result:=GlobalGet(Name) else Result:=Default; end;
procedure GlobalClear(const Name:AnsiString);
begin Bridge('clearglobal',UTF8Decode(Name),''); end;
procedure GlobalClearAll;
begin Bridge('clearglobals','',''); end;
function GlobalCount:Integer;
begin Result:=StrToInt(UTF8Encode(Bridge('globalcount','',''))); end;
function GlobalNames:WideString;
begin Result:=Bridge('globalnames','',''); end;
function CodePage(const S:AnsiString; const Source,Dest:WideString):AnsiString;
begin Result:=DecodeStringBase64(UTF8Encode(Bridge('codepage',UTF8Decode(EncodeStringBase64(S)),Source+','+Dest))); end;
function WinToUTF8(const S:AnsiString):AnsiString; begin Result:=CodePage(S,'ansi','utf-8'); end;
function UTF8ToWin(const S:AnsiString):AnsiString; begin Result:=CodePage(S,'utf-8','ansi'); end;
function OEMToAnsi(const S:AnsiString):AnsiString; begin Result:=CodePage(S,'oem','ansi'); end;
function AnsiToOEM(const S:AnsiString):AnsiString; begin Result:=CodePage(S,'ansi','oem'); end;
function OEMToWide(const S:AnsiString):WideString; begin Result:=UTF8Decode(CodePage(S,'oem','utf-8')); end;
function WideToOEM(const S:WideString):AnsiString; begin Result:=CodePage(UTF8Encode(S),'utf-8','oem'); end;
