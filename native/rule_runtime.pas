procedure SetWide(const Name, Value: AnsiString);
var V: PIFVariant; Ok: Boolean;
begin V := Runtime.GetVar2(Name); if V <> nil then VSetWideString(V, UTF8Decode(Value)); end;
procedure HandleRegex;
var R: TRegExpr; Matches: TJSONArray; M: TJSONObject; Groups: TJSONArray; I: Integer;
begin
  R:=TRegExpr.Create; Matches:=TJSONArray.Create;
  try
    R.Expression:=UTF8Decode(Input.Get('pattern',''));
    R.ModifierI:=not Input.Get('case_sensitive',False);
    if R.Exec(UTF8Decode(Input.Get('text',''))) then repeat
      M:=TJSONObject.Create; M.Add('start',R.MatchPos[0]-1); M.Add('length',R.MatchLen[0]);
      Groups:=TJSONArray.Create;
      for I:=0 to R.SubExprMatchCount do Groups.Add(UTF8Encode(R.Match[I]));
      M.Add('groups',Groups); Matches.Add(M);
    until not R.ExecNext;
    OutputJSON.Add('matches',Matches); Matches:=nil;
  finally Matches.Free; R.Free; end;
end;
procedure Handle;
var Script: AnsiString; I: Integer; V: PIFVariant; Ok: Boolean;
begin
  if Input.Get('operation','')='regex' then begin HandleRegex; Exit; end;
  Script := Input.Get('script', '');
  if (Compiler = nil) or (Script <> Source) then begin
    FreeAndNil(Compiler); FreeAndNil(Runtime);
    Compiler := TPSPascalCompiler.Create; Runtime := TPSExec.Create; Compiler.OnUses := @CompileUses;
    Source := Script;
    if not Compiler.Compile(Script) then begin
      ErrorText := ''; for I := 0 to Compiler.MsgCount - 1 do
        ErrorText := ErrorText + 'Line ' + IntToStr(Max(1,Integer(Compiler.Msg[I].Row)-Input.Get('line_offset',0))) + ': ' + Compiler.Msg[I].ShortMessageToString + LineEnding;
      Source := ''; raise Exception.Create(ErrorText);
    end;
    Compiler.GetOutput(Bytecode);
    if not Runtime.LoadData(Bytecode) then raise Exception.Create('Could not load compiled script');
  end;
  if Input.Get('compile_only', False) then begin OutputJSON.Add('compiled', True); Exit; end;
  SetWide('FILENAME', Input.Get('name', '')); SetWide('FILEPATH', Input.Get('path', ''));
  V := Runtime.GetVar2('INDEX'); if V <> nil then VSetInt(V, Input.Get('index', 1));
  if not Runtime.RunScript then raise Exception.Create(PSErrorToString(Runtime.ExceptionCode, Runtime.ExceptionString));
  V := Runtime.GetVar2('FILENAME');
  if V = nil then raise Exception.Create('FileName is unavailable');
  OutputJSON.Add('name', UTF8Encode(VGetWideString(V)));
end;
begin
  DefaultSystemCodePage := CP_UTF8;
  DefaultFormatSettings.DecimalSeparator:='.';
  TWatchdog.Create(False).FreeOnTerminate:=True;
  while not EOF do begin
    ReadLn(Line); Input := nil; OutputJSON := TJSONObject.Create;
    try
      Input := TJSONObject(GetJSON(Line)); StartedAt:=GetTickCount64; Busy:=True; Handle;
    except on E: Exception do OutputJSON.Add('error', E.Message); end;
    Busy:=False;
    WriteLn(OutputJSON.AsJSON); Flush(System.Output); Input.Free; OutputJSON.Free;
  end;
  Compiler.Free; Runtime.Free;
end.
