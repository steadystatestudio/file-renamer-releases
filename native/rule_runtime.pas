program RuleRuntime;
{$mode objfpc}{$H+}
uses {$IFDEF UNIX}cthreads,cwstring,{$ENDIF} SysUtils, Classes, Math, DateUtils, StrUtils, Character, Variants, base64, uregexpr, fpjson, jsonparser,
  uPSCompiler, uPSRuntime, uPSUtils;
var Compiler: TPSPascalCompiler; Runtime: TPSExec; Source, Bytecode: AnsiString;
    Input, OutputJSON: TJSONObject; Line, ErrorText: AnsiString;
    Busy: Boolean = False; StartedAt: QWord;
type
  TWatchdog = class(TThread)
    procedure Execute; override;
  end;
procedure TWatchdog.Execute;
begin
  while not Terminated do begin
    Sleep(100);
    if Busy and (GetTickCount64-StartedAt>5500) then Halt(124);
  end;
end;

function Bridge(const Kind, A, B: WideString): WideString;
var Q, R: TJSONObject; S: AnsiString;
begin
  Q := TJSONObject.Create;
  Q.Add('query', UTF8Encode(Kind)); Q.Add('a', UTF8Encode(A)); Q.Add('b', UTF8Encode(B));
  WriteLn(Q.AsJSON); Flush(System.Output); Q.Free;
  ReadLn(S); R := TJSONObject(GetJSON(S));
  try
    if R.Find('error') <> nil then raise Exception.Create(R.Get('error', 'Bridge failed'));
    Result := UTF8Decode(R.Get('value', ''));
  finally R.Free; end;
end;
function Meta(const FilePath, Tag: WideString): WideString;
begin Result := Bridge('meta', FilePath, Tag); end;
function WideUpper(const S: WideString): WideString;
begin Result := UnicodeUpperCase(S); end;
function WideLower(const S: WideString): WideString;
begin Result := UnicodeLowerCase(S); end;
function WideTrim(const S: WideString): WideString;
begin Result := Trim(S); end;
function WideExt(const S: WideString): WideString;
begin Result := ExtractFileExt(S); end;
function WideName(const S: WideString): WideString;
begin Result := ExtractFileName(S); end;
function WidePath(const S: WideString): WideString;
begin Result := ExtractFilePath(S); end;
function WideBase(const S: WideString): WideString;
begin Result := ChangeFileExt(ExtractFileName(S), ''); end;
function WideChange(const S, Ext: WideString): WideString;
begin Result := ChangeFileExt(S, Ext); end;
function WideReplace(const S, Old, New: WideString): WideString;
var Flags: TReplaceFlags;
begin
  Flags := [rfReplaceAll];
  Result := UTF8Decode(StringReplace(UTF8Encode(S), UTF8Encode(Old), UTF8Encode(New), Flags));
end;
function WideReplaceText(const S, Old, New: WideString): WideString;
begin Result := UTF8Decode(StringReplace(UTF8Encode(S), UTF8Encode(Old), UTF8Encode(New), [rfReplaceAll, rfIgnoreCase])); end;
function WideCopy(const S: WideString; Index, Count: Integer): WideString;
begin Result := Copy(S, Index, Count); end;
function WideCopyRight(const S: WideString; Index, Count: Integer): WideString;
begin Result := Copy(S, Max(1, Length(S)-Index-Count+2), Min(Count, Length(S)-Index+1)); end;
procedure WideInsert(const S: WideString; var Dest: WideString; Index: Integer);
begin Insert(S, Dest, Index); end;
procedure WideDelete(var S: WideString; Index, Count: Integer);
begin Delete(S, Index, Count); end;
procedure WideDeleteRight(var S: WideString; Index, Count: Integer);
begin Delete(S, Max(1, Length(S)-Index-Count+2), Min(Count, Length(S)-Index+1)); end;
function WideLength(const S: WideString): Integer;
begin Result := Length(S); end;
procedure WideSetLength(var S: WideString; Count: Integer);
begin if (Count<0) or (Count>32768) then raise Exception.Create('String length out of range'); SetLength(S, Count); end;
function WideReverse(const S: WideString): WideString;
var I: Integer;
begin Result := ''; for I:=Length(S) downto 1 do Result := Result + S[I]; end;
function WideRepeat(const S: WideString; Count: Integer): WideString;
var I: Integer;
begin
  if (Count<0) or (Int64(Length(S))*Count>32768) then raise Exception.Create('Repeated string is too long');
  Result := ''; for I:=1 to Count do Result := Result+S;
end;
function WidePosEx(const Sub, S: WideString; Offset: Cardinal): Integer;
begin Result := Pos(Sub, Copy(S, Offset, Length(S))); if Result>0 then Result := Result+Offset-1; end;
function WideTextPos(const Sub, S: WideString): Integer;
begin Result := Pos(UnicodeLowerCase(Sub), UnicodeLowerCase(S)); end;
function WideTextPosEx(const Sub, S: WideString; Offset: Cardinal): Integer;
begin Result := WidePosEx(UnicodeLowerCase(Sub), UnicodeLowerCase(S), Offset); end;
function WideCompare(const A,B: WideString): Integer;
begin if A=B then Result:=0 else if A<B then Result:=-1 else Result:=1; end;
function WideCompareText(const A,B: WideString): Integer;
begin Result:=WideCompare(UnicodeLowerCase(A),UnicodeLowerCase(B)); end;
function WideSameText(const A,B: WideString): Boolean;
begin Result:=WideCompareText(A,B)=0; end;
function WideTrimLeft(const S, Chars: WideString): WideString;
var I: Integer;
begin I:=1; while (I<=Length(S)) and (Pos(S[I],Chars)>0) do Inc(I); Result:=Copy(S,I,Length(S)); end;
function WideTrimRight(const S, Chars: WideString): WideString;
var I: Integer;
begin I:=Length(S); while (I>0) and (Pos(S[I],Chars)>0) do Dec(I); Result:=Copy(S,1,I); end;
function WideTrimChars(const S, Chars: WideString): WideString;
begin Result:=WideTrimRight(WideTrimLeft(S,Chars),Chars); end;
function WidePos(const Sub, S: WideString): Integer;
begin Result := Pos(Sub, S); end;
